    "balance_values_changed": false,
    "visual_assets_changed": false,
    "artistic_approval": false
  },
  "publication": {
    "parent_head": "0ec954c7f6aed51fc309a6b59e7ec3a5e16371d2",
    "changed_paths": [
      "docs/agents/architecture/REGISTRY_VARIANT_MAP.json"
    ],
    "commit_message": "architecture: publish ordinary and elite variant registry map"
  },
  "decisions": {
    "ordinary_roster": {
      "decision": "TEN_ORDINARY_BASE_RECORDS",
      "count": 10,
      "rule": "Ровно восемь существующих Stage 04 base records плюс два уже предложенных ordinary extension ID.",
      "legacy_exclusion": [
        "enemy_stone_oni",
        "enemy_eclipse_serpent"
      ],
      "no_silent_reclassification": true
    },
    "elite_variant_limit": {
      "decision_id": "ARCH-PROD-REG-ELITE-05",
      "decision": "KEEP_FIVE_RUNTIME_BOUND",
      "catalog_count": 10,
      "runtime_registered_limit": 5,
      "limit_semantics": "Лимит 5 относится к runtime_active_registry — run-scoped projection, которую Runtime может зарегистрировать/активировать за один запуск или registry revision. Полный catalog_registry сохраняет все 10 стабильных ID.",
      "selection_scope": "RUN",
      "selection_rule": "Детерминированно выбрать не более пяти ID из полного каталога по content_version и run_seed; exact weighting/cadence/numeric overlays принадлежат Balance.",
      "selection_inputs": [
        "content_version",
        "run_seed",
        "wave_cycle_id",
        "state_revision"
      ],
      "permanent_roster_mutation": false,
      "ids_deleted": false,
      "five_event_cadence_not_implied": "BALANCE_MODEL.json.simulation_model.elite_variation_policy.max_events_per_run остаётся отдельным proposed event-count полем и не переопределяется этой картой."
    },
    "legacy_records": {
      "decision": "PRESERVE_COMPATIBILITY_ONLY",
      "count": 2,
      "rule": "Старые Stage 04 IDs сохраняются для совместимости, но не входят в ordinary roster, не считаются новыми elite variants и не попадают в target 30m runtime selection.",
      "migration": "Стабильные legacy IDs не удалять и не маппить молча на новые IDs; current-run resolver должен quarantine/reject их вне compatibility lookup."
    }
  },
  "namespaces": {
    "ordinary_roster": "ordinary_roster",
    "elite_catalog": "elite_variant_catalog",
    "elite_runtime_projection": "runtime_active_registry",
    "legacy_compatibility": "stage_04_compatibility"
  },
