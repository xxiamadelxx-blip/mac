    { "id": "legacy_sector_reference", "asset": "layers/STAGE02_ARENA_ART_v01.png", "z": 0, "collision": false, "scope": "reference_only" },
    { "id": "gameplay_terrain", "asset": "runtime/procedural", "z": 10, "collision": true, "notes": "Open connected field; shallow water and landmarks are data-driven edges, not a central corridor." },
    { "id": "ambient_vfx", "asset": "layers/STAGE02_ARENA_AMBIENT_VFX_v01.png", "z": 20, "collision": false, "runtime": true, "pooling": true },
    { "id": "remains", "asset": "layers/STAGE02_ARENA_REMAINS_20M_v01.png", "z": 30, "collision": false, "runtime": true, "pooling": true },
    { "id": "xp", "asset": "stage-09", "z": 40, "collision": false, "runtime": true, "notes": "Separate luminous pickup layer; never merge with remains." },
    { "id": "foreground", "asset": "runtime/procedural", "z": 50, "collision": false, "notes": "Only edge foliage; never cover hero, telegraphs or XP." },
    { "id": "hud_safe_area", "asset": "stage-10", "z": 100, "collision": false, "notes": "Reserved top boss area and bottom control area; not part of Stage 02 final HUD." }
