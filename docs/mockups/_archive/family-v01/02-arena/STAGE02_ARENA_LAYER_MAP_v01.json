  },
  "hud_safe_areas_in_viewport": {
    "top": { "rect": [0, 0, 390, 112], "rule": "No critical gameplay objects in this interface band." },
    "bottom": { "rect": [0, 728, 390, 116], "rule": "Keep a readable lane behind future controls." }
  },
  "reactions": [
    { "id": "puddle_ripple", "trigger": "actor_step_or_attack", "duration_ms": 650, "pool_key": "ripple_small" },
    { "id": "plant_sway", "trigger": "wind_or_nearby_actor", "duration_ms": 900, "pool_key": "plant_sway_a" },
    { "id": "leaf_dust", "trigger": "ambient_tick_or_heavy_attack", "duration_ms": 1200, "pool_key": "air_particle" },
    { "id": "eclipse_motes", "trigger": "phase_10_plus", "duration_ms": 1800, "pool_key": "eclipse_mote" }
