      "artifact_instance_id",
      "elite_pack_id",
      "boss_encounter_id",
      "ability_id"
    ],
    "content_version_required": true,
    "unknown_ids": "Quarantine optional records; block authoritative run restore."
  },
  "canonical": {
    "duration_seconds": 1800,
    "boss_checkpoint_seconds": [
      300,
      600,
      900,
      1200,
      1500,
      1800
    ],
    "weapon_slot_limit": 6,
    "passive_slot_limit": 6,
    "weapon_max_level": 6,
    "passive_max_rank": 5,
    "contact_damage_cooldown_seconds": 0.8,
    "source_for_numbers": "../../../docs/BALANCE_ECONOMY_SPEC.md",
    "pending_values": [
      {
        "field": "duration_extension_wave_and_reward_values",
        "status": "PENDING_B1",
        "reason": "B1 is still a 20-minute baseline and does not define extension phase budgets, caps or rewards."
      },
      {
        "field": "new_boss_and_enemy_registry_records",
        "status": "PENDING_CONTENT_REGISTRY",
        "reason": "The brief specifies counts but not stable content identity, mechanics or names."
      },
      {
        "field": "intermediate_boss_03_cadence",
        "status": "PENDING_PRODUCT_DECISION",
        "reason": "The architecture target uses 1350 seconds / 22:30; product approval may replace it registry-only."
      },
      {
        "field": "additional_chest_window_sources_and_outcomes",
        "status": "PENDING_PRODUCT_DECISION",
        "reason": "Seven source windows are reserved to reach the target cap of 15; exact triggers and outcome policy are not supplied."
      },
      {
        "field": "enemy_variant_balance_profiles",
        "status": "PENDING_B1",
        "reason": "Variant weights, allowed phases and numerical overrides must be supplied by Balance."
      },
      {
        "field": "enemy_variant_visual_records",
        "status": "PENDING_VISUAL",
        "reason": "Palette/detail/asset linkage is owned by the visual/content pipeline and no assets are changed here."
      },
      {
        "field": "chest_fallback_reward_values",
        "status": "PENDING_PRODUCT_DECISION",
        "reason": "Sources require a fallback path but do not define its exact content/value."
      },
      {
        "field": "defeat_gold_rounding",
        "status": "PENDING_B1",
        "reason": "B1 says 50% Gold after defeat but does not specify rounding for odd amounts."
      },
      {
        "field": "bonus_series_formula",
        "status": "PENDING_PRODUCT_DECISION",
        "reason": "The existence of an extensible bonus state is required; its exact semantics are not canonical."
      },
      {
        "field": "artifact_effect_definitions",
        "status": "PENDING_PRODUCT_DECISION",
        "reason": "Artifacts are run-modifier effects, not ordinary passive slot modifiers; exact definitions require product approval."
      },
      {
        "field": "artifact_refresh_policy",
        "status": "PENDING_PRODUCT_DECISION",
        "reason": "The three-card offer exposes Get and Refresh, but cost, currency and refresh limit are not canonical."
      },
      {
        "field": "artifact_duplicate_and_stacking_policy",
        "status": "PENDING_PRODUCT_DECISION",
        "reason": "Duplicate and stacking behavior for active artifact effects is not canonical."
      },
      {
        "field": "legacy_v1_save_migration",
        "status": "BLOCKED_EXTERNAL_SYNC",
        "reason": "Runtime migration adapter is outside this architecture folder and requires explicit product/runtime policy."
      }
    ],
    "checkpoint_outcome_policy": {
      "non_final_boss": "CHECKPOINT_REWARD_THEN_CONFIGURED_CHEST_OR_NEXT_STAGE",
      "final_boss": "CHECKPOINT_REWARD_THEN_RUN_VICTORY_NO_BOSS_CHEST"
    },
    "clock_policy": {
      "advances_in": [
        "RUN_ACTIVE",
        "BOSS_INTRO",
        "BOSS_ACTIVE"
      ],
      "freezes_in": [
        "UPGRADE_OFFER",
        "CHEST_OFFER",
        "ARTIFACT_OFFER",
        "RUN_PAUSED",
        "CHECKPOINT_SETTLEMENT",
        "RUN_DEFEAT",
        "RUN_VICTORY",
        "RESULT_REVIEW",
        "REWARD_COMMITTING"
      ],
      "boss_rule": "Elapsed time continues through BOSS_INTRO and BOSS_ACTIVE for every boss; final boss does not pause the run clock."
    },
    "artifact_offer_choice_count": 3,
    "artifact_capacity": "UNBOUNDED_WITHIN_RUN",
    "artifact_effect_model": "RUN_MODIFIER_EFFECTS_SEPARATE_FROM_PASSIVE_SLOTS",
    "main_boss_count": 6,
    "intermediate_boss_count": 3,
    "total_scheduled_encounters": 9,
    "max_chest_windows_per_run": 15,
    "configured_non_final_boss_chest_windows": 8,
    "reserved_additional_chest_windows": 7,
    "max_synergy_claims_per_run": 5,
    "schedule_policy": {
      "status": "TARGET_ARCHITECTURE_WORKING_ASSUMPTION",
      "main_boss_target_seconds": [
        300,
        600,
        900,
        1200,
        1500,
        1800
      ],
      "intermediate_boss_target_seconds": [
        450,
        750,
        1350
      ],
      "final_boss_id": "boss_black_moon_empress",
      "final_boss_target_seconds": 1800,
      "new_main_boss_slots": [
        "boss_extension_slot_04",
        "boss_extension_slot_05"
      ],
      "new_intermediate_slot": "miniboss_extension_slot_03",
      "exact_new_content_and_cadence": "PENDING_CONTENT_REGISTRY/PENDING_B1/PENDING_PRODUCT_DECISION"
    },
    "chest_window_policy": {
      "max_openable_windows_per_run": 15,
      "configured_non_final_boss_windows": 8,
      "reserved_non_boss_windows": 7,
      "one_offer_per_window": true,
      "final_boss_creates_chest": false,
      "boss_chest_sources": [
        "MAIN_BOSS_NON_FINAL",
        "INTERMEDIATE_BOSS"
      ],
      "reserved_source_kind": "ADDITIONAL_CHEST_SOURCE",
      "synergy_claims_are_separate": true,
      "artifact_offers_are_not_chest_windows": true,
      "exact_reserved_sources": "PENDING_PRODUCT_DECISION"
    },
    "wave_policy": {
      "cycle_owner": "WaveCycleDirector",
      "phases": [
        "OPENING",
        "POST_BOSS_RELIEF",
        "RAMP",
        "PRE_BOSS_PEAK",
        "BOSS_ACTIVE"
      ],
      "post_boss_rule": "Every non-final main/intermediate encounter enters relief before gradual ramp; no direct jump to peak.",
      "clock_during_boss": "ADVANCES",
      "exact_phase_boundaries": "PENDING_B1",
      "exact_spawn_budget_profiles": "PENDING_B1",
      "exact_active_cap_profiles": "PENDING_B1"
    },
    "enemy_variant_policy": {
      "resolver": "EnemyVariantResolver",
      "deterministic_inputs": [
        "content_version",
        "run_seed",
        "wave_cycle_id",
        "base_enemy_id",
        "state_revision"
      ],
      "base_enemy_id": "enemy_ink_beetle",
      "variant_ids": [
        "enemy_ink_beetle_variant_01",
        "enemy_ink_beetle_variant_02",
        "enemy_ink_beetle_variant_03"
      ],
      "visual_rule": "Each variant has a readable detail/marker beyond hue; color is not the only signal.",
      "reward_rule": "Variants inherit base XP/drop/aftermath boundary unless B1 explicitly overrides it.",
      "numeric_overrides": "PENDING_B1",
      "visual_assets": "PENDING_VISUAL"
    }
  },
