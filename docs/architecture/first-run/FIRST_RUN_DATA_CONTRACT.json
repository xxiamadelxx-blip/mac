      },
      {
        "field": "boss_absolute_stats_and_phase_thresholds",
        "status": "PENDING_B1",
        "reason": "The architecture exposes the fields without inventing boss tuning."
      },
      {
        "field": "chest_fallback_reward_values",
        "status": "PENDING_PRODUCT_DECISION",
        "reason": "Sources require a fallback path but do not define its exact content/value."
      },
      {
        "field": "defeat_gold_rounding",
        "status": "PENDING_B1",
        "reason": "B1 says 50% Gold after defeat but does not specify rounding for odd amounts."
      },
      {
        "field": "bonus_series_formula",
        "status": "PENDING_PRODUCT_DECISION",
        "reason": "The existence of an extensible bonus state is required; its exact semantics are not canonical."
      }
    ],
