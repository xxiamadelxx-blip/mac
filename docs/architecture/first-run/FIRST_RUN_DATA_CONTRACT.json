  "run_session_contract": {
    "name": "RunSession",
    "version": 1,
    "required_fields": [
      "run_id",
      "seed",
      "content_version",
      "phase",
      "revision",
      "elapsed_seconds",
      "current_wave_band_id",
      "checkpoint_id",
      "selected_hero_id",
      "build",
      "stats",
      "counters",
      "drops",
      "pending_offer",
      "pending_chest",
      "diagnostics"
    ],
    "fields": {
      "run_id": {
        "type": "string",
        "format": "run_<uuid>"
      },
      "seed": {
        "type": "string_or_uint64",
        "purpose": "deterministic offers/spawns where product rules permit"
      },
      "content_version": {
        "type": "string"
      },
      "phase": {
        "type": "string",
        "enum": [
          "RUN_LOADING",
          "RUN_ACTIVE",
          "UPGRADE_CHOICE",
          "BOSS_TELEGRAPH",
          "BOSS_ACTIVE",
          "CHEST_PENDING",
          "CHECKPOINT_RESOLVED",
          "PAUSED",
          "BACKGROUND_SUSPENDED",
          "DEFEAT",
          "VICTORY",
          "RESULTS_PENDING",
          "RESULTS_CLAIMED"
        ]
      },
      "revision": {
        "type": "integer",
        "minimum": 0
      },
      "elapsed_seconds": {
        "type": "number",
        "minimum": 0,
        "maximum": 1200,
        "source": "RunClock"
      },
      "current_wave_band_id": {
        "type": "string",
        "ref": "wave_bands[].id"
      },
      "checkpoint_id": {
        "type": "string_or_null",
        "ref": "bosses[].checkpoint_id"
      },
      "selected_hero_id": {
        "type": "string",
        "ref": "content_catalog.heroes[].id"
      },
      "build": {
        "type": "BuildState",
        "slot_capacities": {
          "weapons": 6,
          "passives": 6,
          "artifacts": 3
        },
        "weapon_level_range": [
          1,
          6
        ],
        "passive_level_range": [
          1,
          5
        ],
        "fields": [
          "weapons",
          "passives",
          "artifacts",
          "claimed_synergy_ids"
        ]
      },
      "stats": {
        "type": "StatsState",
        "fields": {
          "hp": "number_or_PENDING_B1",
          "max_hp": "number_or_PENDING_B1",
          "attack": "number_or_PENDING_B1",
          "critical_chance": "number_or_PENDING_B1",
          "critical_multiplier": "number_or_PENDING_B1",
          "movement_speed": "number_or_PENDING_B1",
          "cooldown": "number_or_PENDING_B1",
          "armor": "number_or_PENDING_B1",
          "pickup_radius": "number_or_PENDING_B1",
          "bonus_state": "object_or_null_PENDING_PRODUCT_DECISION"
        }
      },
      "counters": {
        "type": "CountersState",
        "fields": {
          "level": "integer",
          "xp_current": "integer_or_number",
          "xp_to_next": "integer_or_number",
          "kills": "integer",
          "bosses_defeated": "integer",
          "checkpoints_resolved": "integer"
        },
        "xp_formula": "round(30 + 12 * (L - 1) + 3 * (L - 1)^1.35)",
        "source_status": "B1"
      },
      "drops": {
        "type": "TypedDropState",
        "xp_items": {
          "type": "array",
          "item_fields": [
            "drop_id",
            "value",
            "source_enemy_id",
            "collectible",
            "merge_key"
          ],
          "collectible": true
        },
        "aftermath_items": {
          "type": "array",
          "item_fields": [
            "aftermath_id",
            "source_enemy_id",
            "visual_kind",
            "collectible",
            "collision",
            "xp_value",
            "cluster_state"
          ],
          "collectible": false,
          "collision": false,
          "xp_value": 0
        },
        "separation_invariant": "XP items change counters; aftermath items never do."
      },
      "pending_offer": {
        "type": "UpgradeOfferSet_or_null",
        "fields": [
          "offer_id",
          "generation_seed",
          "offers",
          "expires_on",
          "selected_offer_id"
        ],
        "offer_count": 3
      },
      "pending_chest": {
        "type": "ChestOffer_or_null",
        "fields": [
          "chest_id",
          "offer_id",
          "boss_id",
          "checkpoint_id",
          "eligible_synergy_ids",
          "fallback_outcome",
          "claim_status"
        ]
      },
      "diagnostics": {
        "type": "array",
        "item_fields": [
          "diagnostic_id",
          "reason_code",
          "operation",
          "affected_id",
          "content_version",
          "recoverability",
          "user_action"
        ]
      }
    }
  },
  "build_state_contract": {
    "weapons": [
      {
        "weapon_id": "string_ref",
        "level": "integer_1_to_6",
        "evolution_id": "string_or_null",
        "evolved": "boolean"
      }
