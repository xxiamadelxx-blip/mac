  "id_policy": {
    "rule": "IDs are stable semantic slugs; display labels are localized and never used as keys.",
    "scopes": [
      "run_id",
      "hero_id",
      "weapon_id",
      "passive_id",
      "synergy_id",
      "artifact_id",
      "enemy_id",
