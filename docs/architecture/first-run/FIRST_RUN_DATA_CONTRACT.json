      {
        "passive_id": "string_ref",
        "level": "integer_1_to_5"
      }
    ],
    "artifacts": [
      {
        "artifact_id": "string_ref",
        "level": "integer_or_pending_content",
        "source_chest_id": "string_ref"
      }
    ],
    "claimed_synergy_ids": [
      "synergy_id"
    ],
    "slot_rule": "A new weapon/passive is legal only when its respective capacity is not full; upgrades remain legal at capacity."
  },
  "synergy_resolution_contract": {
    "input": [
      "build_state",
      "chest_id",
      "content_version"
    ],
    "eligible_synergy_ids": [
      "synergy_id"
    ],
    "eligibility_rules": [
      "weapon level equals 6",
      "paired passive level equals 5",
      "synergy not already claimed",
      "chest claim not already committed",
      "pair resolves in content registry"
    ],
    "outcome": {
      "kind": "synergy_selection_or_fallback",
      "selected_synergy_id": "string_or_null",
      "fallback_kind": "PENDING_PRODUCT_DECISION",
      "fallback_payload": null
    },
    "duplicate_policy": "Same chest_id returns the original outcome and cannot apply a second evolution."
  },
  "chest_offer_contract": {
    "chest_id": "chest_<run_id>_<boss_id>",
    "offer_id": "offer_<chest_id>_<revision>",
    "boss_id": "boss_id",
